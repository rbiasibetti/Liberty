# Copie para .env.local (ignorado pelo Git) e preencha. Nunca commite valores reais.
LIBERTY_TEST_DB_HOST=localhost
LIBERTY_TEST_DB_PORT=1433
LIBERTY_TEST_DB_USER=
LIBERTY_TEST_DB_PASSWORD=

# Conta técnica do /actuator/prometheus (usuário "metrics"); sem senha o endpoint fica fechado
LIBERTY_METRICS_PASSWORD=
# Rastros OpenTelemetry (0 a 1; 0 desliga) e destino OTLP/HTTP
LIBERTY_TRACE_SAMPLING=0.0
LIBERTY_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
