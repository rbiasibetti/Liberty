#!/usr/bin/env bash
# Conventional Commits: tipo(escopo opcional)!: descrição
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,100}$'
first_line=$(head -n1 "$1")
case "$first_line" in Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;; esac
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "Mensagem de commit fora do padrão Conventional Commits:" >&2
  echo "  $first_line" >&2
  echo "Exemplo: feat(engine): valida corpo contra o JSON Schema" >&2
  exit 1
fi
