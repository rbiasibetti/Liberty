<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.liberty</groupId>
    <artifactId>liberty-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>liberty-engine</artifactId>
  <name>Liberty Engine</name>
  <description>Motor de execução das integrações publicadas: roteamento, validação, leitura e escrita</description>

  <dependencies>
    <dependency>
      <groupId>br.com.liberty</groupId>
      <artifactId>liberty-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>br.com.liberty</groupId>
      <artifactId>liberty-snapshot</artifactId>
    </dependency>
    <dependency>
      <groupId>br.com.liberty</groupId>
      <artifactId>liberty-infrastructure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>br.com.liberty</groupId>
      <artifactId>liberty-infrastructure</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mssqlserver</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Fiação do Spring (beans e propriedades): coberta pelos testes de contrato do liberty-app -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>br/com/liberty/engine/EngineConfig.class</exclude>
            <exclude>br/com/liberty/engine/LibertyEngineProperties.class</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
