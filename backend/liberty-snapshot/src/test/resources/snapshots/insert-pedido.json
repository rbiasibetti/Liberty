{
  "schemaVersion": 1,
  "integration": { "key": "pedido", "name": "Pedido de venda", "method": "POST", "route": "/pedidos" },
  "request": {
    "params": [{ "name": "loja", "in": "query", "type": "string", "required": false, "maxLength": 20 }],
    "bodySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["numero", "cliente", "itens"],
      "additionalProperties": false,
      "properties": {
        "numero": { "type": "string", "pattern": "^[A-Z0-9-]{1,30}$" },
        "cliente": {
          "type": "object",
          "required": ["documento"],
          "properties": { "documento": { "type": "string", "maxLength": 18 }, "nome": { "type": "string" } }
        },
        "itens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["sku", "qtd"],
            "properties": { "sku": { "type": "string" }, "qtd": { "type": "number", "exclusiveMinimum": 0 }, "preco": { "$ref": "#/$defs/dinheiro" } }
          }
        }
      },
      "$defs": { "dinheiro": { "type": "number", "minimum": 0 } }
    },
    "maxBodyBytes": 1048576
  },
  "operation": {
    "type": "INSERT",
    "write": {
      "root": {
        "table": "dbo.tb_pedido",
        "primaryKey": "id",
        "fields": [
          { "column": "nr_pedido", "source": "/numero", "transforms": [{ "fn": "trim" }, { "fn": "upper" }] },
          { "column": "nr_documento", "source": "/cliente/documento", "transforms": [{ "fn": "digits" }] },
          { "column": "cd_loja", "param": "loja", "transforms": [{ "fn": "default", "args": ["MATRIZ"] }] },
          { "column": "origem", "constant": "API" }
        ],
        "children": [
          {
            "table": "dbo.tb_pedido_item",
            "arrayPath": "/itens",
            "foreignKey": "pedido_id",
            "fields": [
              { "column": "cd_produto", "source": "/sku" },
              { "column": "qt_vendida", "source": "/qtd", "transforms": [{ "fn": "toDecimal", "args": [3] }] },
              { "column": "vl_unitario", "source": "/preco" }
            ]
          }
        ]
      }
    }
  },
  "scripts": { "beforeExecute": "function beforeExecute(input){ return input; }" },
  "namedQueries": [{ "name": "cliente_por_documento", "sql": "SELECT id FROM dbo.tb_cliente WHERE nr_documento = :doc", "params": ["doc"] }],
  "response": { "successStatus": 201 },
  "idempotency": { "required": true },
  "tests": [
    {
      "name": "cria pedido com dois itens",
      "request": {
        "params": { "loja": "L1" },
        "body": { "numero": "P-1", "cliente": { "documento": "111.444.777-35" }, "itens": [{ "sku": "A", "qtd": 1 }, { "sku": "B", "qtd": 2 }] }
      },
      "expect": { "status": 201 }
    }
  ]
}
