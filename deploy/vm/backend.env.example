# Copie para /etc/liberty/backend.env (dono root, modo 0640, grupo liberty). Nunca commite valores reais.

# Só o nginx fala com a API: ela escuta apenas em localhost
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Banco central (liberty_core) e o usuário de aplicação dele
LIBERTY_CORE_URL=jdbc:sqlserver://HOST:1433;databaseName=liberty_core;encrypt=true;trustServerCertificate=false
LIBERTY_CORE_APP_USER=liberty_core_app
LIBERTY_CORE_APP_PASSWORD=

# Cofre de segredos (senhas dos bancos dos clientes e chaves de assinatura dos tokens)
LIBERTY_VAULT_URI=https://vault.exemplo.com:8200
LIBERTY_VAULT_AUTH=TOKEN
LIBERTY_VAULT_TOKEN=

# URL pública desta API (vai no emissor dos tokens de cliente) e provedor de login dos usuários
LIBERTY_SECURITY_ISSUER=https://liberty.exemplo.com
LIBERTY_OIDC_ISSUER=https://login.exemplo.com/realms/liberty
# Origens do navegador autorizadas a chamar a API (vazio quando a interface é servida na mesma origem)
LIBERTY_ALLOWED_ORIGINS=

# Conta técnica do /actuator/prometheus (usuário "metrics"); sem senha o endpoint fica fechado
LIBERTY_METRICS_PASSWORD=

# Scripts: o trabalhador usa a pasta worker-lib do pacote ativo
LIBERTY_SCRIPTS_WORKER_CLASSPATH=/opt/liberty/current/backend/worker-lib/*

# Exportações: pasta dos arquivos (num volume com backup) e chave das URLs assinadas (32+ caracteres,
# a mesma em todas as instâncias). Gere uma com: openssl rand -base64 48
LIBERTY_EXPORT_DIR=/var/lib/liberty/exports
LIBERTY_EXPORT_SIGNING_KEY=

# Opcionais
# LIBERTY_REDIS_URI=redis://:senha@host:6379
# LIBERTY_TRACE_SAMPLING=0.0
# LIBERTY_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
